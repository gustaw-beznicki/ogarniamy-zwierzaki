---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getMessages, localePath } from '../i18n';
import { SessionGate } from '../components/SessionGate';
import { AuthForm } from '../components/AuthForm';
const locale = 'pl' as const;
const messages = getMessages(locale);
const route = 'signin';
const alternateLocaleHref = localePath('en', route);
---
<BaseLayout locale={locale} messages={messages}><SessionGate locale={locale} messages={messages} destination="signin" client:load><AuthForm locale={locale} messages={messages} client:load /></SessionGate></BaseLayout>
