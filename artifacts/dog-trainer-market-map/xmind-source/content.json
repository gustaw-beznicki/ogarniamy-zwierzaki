  {
    "id": "sheet-use-cases-20260919",
    "class": "sheet",
    "title": "2. Scenariusze biznesowe",
    "rootTopic": {
      "id": "root-use-cases-20260919",
      "class": "topic",
      "title": "🚀 8 scenariuszy biznesowych",
      "structureClass": "org.xmind.ui.map.unbalanced",
      "children": {"attached": [
        {"id": "uc1", "title": "1️⃣ Kwalifikacja nowego przypadku", "children": {"attached": [
          {"id": "uc1-problem", "title": "Problem", "children": {"attached": [
            {"id": "uc1-p1", "title": "Lead z Instagrama / telefonu"},
            {"id": "uc1-p2", "title": "Darmowa diagnoza w wiadomościach"},
            {"id": "uc1-p3", "title": "Dane rozproszone w formularzu, mailu i kalendarzu"}
          ]}},
          {"id": "uc1-solution", "title": "Proces docelowy", "children": {"attached": [
            {"id": "uc1-s1", "title": "Dynamiczna ankieta zależna od problemu"},
            {"id": "uc1-s2", "title": "Reguły ryzyka i rekomendacja właściwej usługi"},
            {"id": "uc1-s3", "title": "Zgody → termin → płatność → karta przypadku"}
          ]}},
          {"id": "uc1-value", "title": "Wartość", "children": {"attached": [
            {"id": "uc1-v1", "title": "Więcej płatnych konsultacji"},
            {"id": "uc1-v2", "title": "Mniej obsługi leada i błędnej kwalifikacji"}
          ]}}
        ]}},
        {"id": "uc2", "title": "2️⃣ Sprzedaż programu zamiast wizyty", "children": {"attached": [
          {"id": "uc2-problem", "title": "Problem", "children": {"attached": [
            {"id": "uc2-p1", "title": "Klient płaci osobno za każdą godzinę"},
            {"id": "uc2-p2", "title": "Trener ręcznie liczy spotkania i raty"}
          ]}},
          {"id": "uc2-solution", "title": "Proces docelowy", "children": {"attached": [
            {"id": "uc2-s1", "title": "Program 6 tygodni: konsultacja + sesje + zadania + feedback"},
            {"id": "uc2-s2", "title": "Płatność jednorazowa lub raty"},
            {"id": "uc2-s3", "title": "Automatyczne saldo, ważność i limity wsparcia"}
          ]}},
          {"id": "uc2-value", "title": "Wartość", "children": {"attached": [
            {"id": "uc2-v1", "title": "Wyższy koszyk i przewidywalny przychód"},
            {"id": "uc2-v2", "title": "Mniej porzuceń po pierwszej sesji"}
          ]}}
        ]}},
        {"id": "uc3", "title": "3️⃣ Zamknięcie sesji bez papierologii", "children": {"attached": [
          {"id": "uc3-problem", "title": "Problem", "children": {"attached": [
            {"id": "uc3-p1", "title": "Notatki, PDF-y i rozliczenia po godzinach"}
          ]}},
          {"id": "uc3-solution", "title": "Proces docelowy", "children": {"attached": [
            {"id": "uc3-s1", "title": "60–90 s notatki głosowej"},
            {"id": "uc3-s2", "title": "AI tworzy szkic prywatnej dokumentacji i podsumowania klienta"},
            {"id": "uc3-s3", "title": "Trener zatwierdza → zadania → rozliczenie pakietu → kolejny termin"}
          ]}},
          {"id": "uc3-value", "title": "Wartość", "children": {"attached": [
            {"id": "uc3-v1", "title": "Minuty administracji na sesję zamiast kilkunastu"},
            {"id": "uc3-v2", "title": "AI tylko szkic — specjalista podejmuje decyzję"}
          ]}}
        ]}},
        {"id": "uc4", "title": "4️⃣ Praca pomiędzy spotkaniami", "children": {"attached": [
          {"id": "uc4-problem", "title": "Problem", "children": {"attached": [
            {"id": "uc4-p1", "title": "PDF ginie, klient nie pamięta ćwiczeń"},
            {"id": "uc4-p2", "title": "Brak wiedzy: zła metoda, złe wykonanie czy brak pracy?"}
          ]}},
          {"id": "uc4-solution", "title": "Proces docelowy", "children": {"attached": [
            {"id": "uc4-s1", "title": "Zadanie + film + liczba powtórzeń + warunki przerwania"},
            {"id": "uc4-s2", "title": "Check-in, skala trudności i krótkie nagranie klienta"},
            {"id": "uc4-s3", "title": "Panel wyjątków dla trenera: gdzie potrzebna reakcja"}
          ]}},
          {"id": "uc4-monetization", "title": "Monetyzacja wsparcia", "children": {"attached": [
            {"id": "uc4-m1", "title": "Limit pytań / analiz wideo w pakiecie"},
            {"id": "uc4-m2", "title": "Dodatkowy feedback jako płatny produkt"}
          ]}}
        ]}},
        {"id": "uc5", "title": "5️⃣ Kurs grupowy dla szczeniąt", "children": {"attached": [
          {"id": "uc5-problem", "title": "Problem", "children": {"attached": [
            {"id": "uc5-p1", "title": "Zapisy, szczepienia, płatności i obecność w różnych miejscach"}
          ]}},
          {"id": "uc5-solution", "title": "Proces docelowy", "children": {"attached": [
            {"id": "uc5-s1", "title": "Kwalifikacja pary pies + przewodnik"},
            {"id": "uc5-s2", "title": "Płatność za cykl, wszystkie terminy, kolejka i lista obecności"},
            {"id": "uc5-s3", "title": "Materiały za nieobecność i odrabianie"},
            {"id": "uc5-s4", "title": "Kompetencje psa → propozycja kolejnego poziomu"}
          ]}},
          {"id": "uc5-value", "title": "Wartość", "children": {"attached": [
            {"id": "uc5-v1", "title": "Większe obłożenie grup i automatyczny upsell"}
          ]}}
        ]}},
        {"id": "uc6", "title": "6️⃣ Dom z wieloma psami i opiekunami", "children": {"attached": [
          {"id": "uc6-problem", "title": "Problem", "children": {"attached": [
            {"id": "uc6-p1", "title": "Płatnik, ćwiczący opiekun i pies to różne role"}
          ]}},
          {"id": "uc6-solution", "title": "Proces docelowy", "children": {"attached": [
            {"id": "uc6-s1", "title": "Jedno gospodarstwo → wielu opiekunów → wiele psów"},
            {"id": "uc6-s2", "title": "Osobne programy i historie psów"},
            {"id": "uc6-s3", "title": "Uprawnienia: instrukcje tak, finanse nie"}
          ]}},
          {"id": "uc6-value", "title": "Wartość", "children": {"attached": [
            {"id": "uc6-v1", "title": "Brak duplikatów i pomieszanych historii"}
          ]}}
        ]}},
        {"id": "uc7", "title": "7️⃣ Przekazanie przypadku w zespole", "children": {"attached": [
          {"id": "uc7-problem", "title": "Problem", "children": {"attached": [
            {"id": "uc7-p1", "title": "Wiedza o psie istnieje tylko w głowie jednego trenera"}
          ]}},
          {"id": "uc7-solution", "title": "Proces docelowy", "children": {"attached": [
            {"id": "uc7-s1", "title": "Przydział według specjalizacji, miejsca i obciążenia"},
            {"id": "uc7-s2", "title": "Triggery, bezpieczeństwo i historia pod ręką"},
            {"id": "uc7-s3", "title": "Uprawnienia, zastępstwa i prowizje"}
          ]}},
          {"id": "uc7-value", "title": "Wartość", "children": {"attached": [
            {"id": "uc7-v1", "title": "Skalowanie szkoły bez utraty jakości"}
          ]}}
        ]}},
        {"id": "uc8", "title": "8️⃣ Zakończenie, odnowienie i polecenie", "children": {"attached": [
          {"id": "uc8-problem", "title": "Problem", "children": {"attached": [
            {"id": "uc8-p1", "title": "Koniec programu = przypadkowy koniec relacji"}
          ]}},
          {"id": "uc8-solution", "title": "Proces docelowy", "children": {"attached": [
            {"id": "uc8-s1", "title": "Raport: punkt wyjścia → praca → wynik"},
            {"id": "uc8-s2", "title": "Kolejny poziom / klub utrzymaniowy / kontrola"},
            {"id": "uc8-s3", "title": "Opinia i program poleceń we właściwym momencie"}
          ]}},
          {"id": "uc8-value", "title": "Wartość", "children": {"attached": [
            {"id": "uc8-v1", "title": "Retencja, ponowny zakup i rekomendacje"}
          ]}}
        ]}}
      ]}
    },
